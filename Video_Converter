def montar_comando(video, destino, config):

    comando = [

        str(FFMPEG),

        "-y",

        "-i",

        str(video),

    ]


    # --------------------------------------------------------
    # Redimensionamento inteligente
    # --------------------------------------------------------

    if config["escala"]:

        comando.extend([

            "-vf",

            f"scale=-2:{config['escala']}"

        ])


    # --------------------------------------------------------
    # Redução de FPS
    # --------------------------------------------------------

    if config["reduzir_fps"]:

        comando.extend([

            "-r",

            "30"

        ])


    # --------------------------------------------------------
    # Codec de vídeo
    # --------------------------------------------------------

    comando.extend([

        "-c:v",

        "libx265",

        "-preset",

        config["preset"],

        "-crf",

        str(config["crf"])

    ])


    # --------------------------------------------------------
    # Áudio
    # --------------------------------------------------------

    comando.extend([

        "-c:a",

        "aac",

        "-b:a",

        "128k"

    ])


    # --------------------------------------------------------
    # Compatibilidade streaming
    # --------------------------------------------------------

    comando.extend([

        "-movflags",

        "+faststart",

        str(destino)

    ])


    return comando



# ============================================================
# VALIDAÇÃO
# ============================================================


def validar_video(video):

    try:

        info = analisar_video(video)

        return (

            info["duracao"] > 0

            and

            info["largura"] > 0

            and

            info["altura"] > 0

        )


    except:

        return False



# ============================================================
# PROCESSAMENTO INDIVIDUAL
# ============================================================


def processar_video(video):

    global TOTAL_ORIGINAL
    global TOTAL_FINAL


    inicio = time.time()


    tamanho_original = os.path.getsize(video)


    TOTAL_ORIGINAL += tamanho_original


    destino = PASTA_DESTINO / f"{video.stem}.mp4"



    print("\n")
    print("=" * 70)

    print(f"Arquivo: {video.name}")


    # --------------------------------------------------------
    # Se já existe uma conversão válida
    # --------------------------------------------------------

    if destino.exists():

        if validar_video(destino):

            print("✔ Arquivo já convertido. Pulando.")

            tamanho_final = os.path.getsize(destino)

            TOTAL_FINAL += tamanho_final


            return



    # --------------------------------------------------------
    # Análise
    # --------------------------------------------------------

    print("Analisando vídeo...")


    info = analisar_video(video)


    config = estrategia(info)


    print()

    print(
        f"Resolução: "
        f"{info['largura']}x{info['altura']}"
    )


    print(
        f"FPS: {info['fps']:.2f}"
    )


    print(
        f"Codec original: {info['codec']}"
    )


    print(
        f"Orientação: {info['orientacao']}"
    )


    print()

    print("Estratégia:")


    if config["escala"]:

        print(
            f"- Reduzindo para {config['escala']}p"
        )

    else:

        print(
            "- Mantendo resolução"
        )


    if config["reduzir_fps"]:

        print(
            "- Reduzindo FPS para 30"
        )


    print(
        f"- H.265"
    )

    print(
        f"- CRF {config['crf']}"
    )


    # --------------------------------------------------------
    # Executa FFmpeg
    # --------------------------------------------------------

    comando = montar_comando(

        video,

        destino,

        config

    )


    print()

    print("Comprimindo...")


    resultado = subprocess.run(

        comando,

        stdout=subprocess.DEVNULL,

        stderr=subprocess.PIPE,

        text=True

    )


    if resultado.returncode != 0:


        print()

        print("❌ Erro no FFmpeg")

        LOG.append({

            "arquivo": video.name,

            "status": "Erro",

            "mensagem":
                resultado.stderr[-500:]

        })


        return



    # --------------------------------------------------------
    # Validação final
    # --------------------------------------------------------

    if not validar_video(destino):


        print(
            "❌ Arquivo final inválido."
        )


        if destino.exists():

            destino.unlink()


        return



    copiar_datas(

        video,

        destino

    )


    tamanho_final = os.path.getsize(destino)


    TOTAL_FINAL += tamanho_final


    economia = (

        1 -

        (tamanho_final / tamanho_original)

    ) * 100


    tempo_execucao = time.time() - inicio



    print()

    print("✔ Finalizado")

    print(

        f"Original: "
        f"{tamanho_mb(tamanho_original):.2f} MB"

    )


    print(

        f"Final: "
        f"{tamanho_mb(tamanho_final):.2f} MB"

    )


    print(

        f"Economia: "
        f"{economia:.1f}%"

    )


    print(

        f"Tempo: "
        f"{tempo(tempo_execucao)}"

    )


    RELATORIO.append({

        "Arquivo": video.name,

        "Original MB":

            round(
                tamanho_mb(tamanho_original),
                2
            ),

        "Final MB":

            round(
                tamanho_mb(tamanho_final),
                2
            ),

        "Economia %":

            round(
                economia,
                2
            ),

        "Tempo":

            tempo(tempo_execucao),

        "Resolução":

            f"{info['largura']}x{info['altura']}",

        "Codec":

            "H265"

    })



