def gerar_log():

    arquivo = (

        PASTA_ORIGEM /

        "Log_Compressao.txt"

    )


    with open(

        arquivo,

        "w",

        encoding="utf-8"

    ) as f:


        f.write(
            "LOG - COMPRESSOR DE VÍDEOS\n"
        )

        f.write(
            "=" * 60
        )

        f.write("\n\n")


        f.write(

            f"Data: "
            f"{datetime.now()}\n\n"

        )


        if LOG:


            f.write(

                "ERROS ENCONTRADOS:\n\n"

            )


            for erro in LOG:


                f.write(

                    f"Arquivo: "
                    f"{erro['arquivo']}\n"

                )

                f.write(

                    f"Status: "
                    f"{erro['status']}\n"

                )

                f.write(

                    f"Mensagem:\n"
                    f"{erro['mensagem']}\n"

                )

                f.write(
                    "-" * 50
                )

                f.write("\n")


        else:


            f.write(

                "Nenhum erro encontrado.\n"

            )



    print()

    print(

        f"✔ Log criado:"
    )

    print(

        arquivo
    )



