# ============================================================
# FUNÇÕES AUXILIARES
# ============================================================

def tamanho_mb(valor):

    return valor / (1024 * 1024)


def tamanho_gb(valor):

    return valor / (1024 * 1024 * 1024)


def tempo(segundos):

    segundos = int(segundos)

    h = segundos // 3600
    m = (segundos % 3600) // 60
    s = segundos % 60

    if h:

        return f"{h:02}:{m:02}:{s:02}"

    return f"{m:02}:{s:02}"


def copiar_datas(original, novo):

    stat = os.stat(original)

    os.utime(
        novo,
        (
            stat.st_atime,
            stat.st_mtime
        )
    )


# ============================================================
# FFPROBE
# ============================================================

def analisar_video(video):

    comando = [

        str(FFPROBE),

        "-v",
        "quiet",

        "-print_format",
        "json",

        "-show_format",

        "-show_streams",

        str(video)

    ]

    resultado = subprocess.run(

        comando,

        capture_output=True,

        text=True

    )

    dados = json.loads(resultado.stdout)

    video_stream = None

    audio_stream = None

    for stream in dados["streams"]:

        if stream["codec_type"] == "video":
            video_stream = stream

        if stream["codec_type"] == "audio":
            audio_stream = stream

    largura = int(video_stream["width"])

    altura = int(video_stream["height"])

    codec = video_stream["codec_name"]

    fps_texto = video_stream["r_frame_rate"]

    try:

        a, b = fps_texto.split("/")

        fps = float(a) / float(b)

    except:

        fps = 30

    bitrate = int(

        video_stream.get(

            "bit_rate",

            dados["format"].get(

                "bit_rate",

                0

            )

        )

    )

    duracao = float(dados["format"]["duration"])

    orientacao = "Vertical" if altura > largura else "Horizontal"

    return {

        "largura": largura,

        "altura": altura,

        "codec": codec,

        "fps": fps,

        "bitrate": bitrate,

        "duracao": duracao,

        "orientacao": orientacao

    }


# ============================================================
# DECISÃO INTELIGENTE
# ============================================================

def estrategia(info):

    altura = info["altura"]

    bitrate = info["bitrate"] / 1_000_000

    fps = info["fps"]

    codec = info["codec"]

    escala = None

    crf = 27

    preset = "slow"

    reduzir_fps = False

    # --------------------------------------------------------

    if altura >= 2160:

        escala = 1080

        crf = 28

    elif altura >= 1440:

        escala = 1080

        crf = 27

    elif altura >= 1080:

        escala = None

        crf = 27

    elif altura >= 720:

        escala = None

        crf = 25

    else:

        escala = None

        crf = 23

    # --------------------------------------------------------

    if bitrate > 25:

        crf += 1

    elif bitrate < 4:

        crf -= 1

    # --------------------------------------------------------

    if codec == "hevc":

        crf -= 1

    # --------------------------------------------------------

    if fps > 35:

        reduzir_fps = True

    # --------------------------------------------------------

    crf = max(20, min(30, crf))

    return {

        "escala": escala,

        "crf": crf,

        "preset": preset,

        "reduzir_fps": reduzir_fps

    }


