# ============================================================
# GERA RELATÓRIO EXCEL
# ============================================================


def gerar_excel():

    if not RELATORIO:

        return


    arquivo = (

        PASTA_ORIGEM /

        "Relatorio_Compressao.xlsx"

    )


    wb = Workbook()

    ws = wb.active

    ws.title = "Compressão"


    cabecalho = [

        "Arquivo",

        "Original MB",

        "Final MB",

        "Economia %",

        "Tempo",

        "Resolução",

        "Codec"

    ]


    ws.append(cabecalho)


    for item in RELATORIO:

        ws.append([

            item["Arquivo"],

            item["Original MB"],

            item["Final MB"],

            item["Economia %"],

            item["Tempo"],

            item["Resolução"],

            item["Codec"]

        ])


    # Formatação

    for cell in ws[1]:

        cell.font = Font(
            bold=True
        )

        cell.alignment = Alignment(
            horizontal="center"
        )


    for coluna in ws.columns:

        maior = 0

        letra = coluna[0].column_letter


        for celula in coluna:

            if celula.value:

                maior = max(

                    maior,

                    len(str(celula.value))

                )


        ws.column_dimensions[letra].width = maior + 3



    wb.save(arquivo)


    print()

    print(
        f"✔ Relatório Excel criado:"
    )

    print(
        arquivo
    )



